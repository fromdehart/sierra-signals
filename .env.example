# Sierra Signals — Environment Variables
# Copy this file to .env and fill in your keys.

# Optional: Brave Search API key (get one at https://brave.com/search/api/)
BRAVE_API_KEY=

# Optional: Tavily API key (get one at https://tavily.com)
TAVILY_API_KEY=

# Optional: Anthropic API key — enables fast Claude classification (~5s vs ~90s subprocess)
ANTHROPIC_API_KEY=

# Optional: OpenAI API key — enables OpenAI models for classification and outreach
OPENAI_API_KEY=

# Optional: Google OAuth credentials — enables "Create Gmail Draft" button
# Create at https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
# Choose "Desktop app" type — no redirect URI needed, Google allows loopback automatically
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server port (default 3001)
PORT=3002
