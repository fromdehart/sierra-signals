# Sierra Signals — Environment Variables
# Copy this file to .env and fill in your keys.

# Optional: Brave Search API key (get one at https://brave.com/search/api/)
BRAVE_API_KEY=

# Optional: Tavily API key (get one at https://tavily.com)
TAVILY_API_KEY=

# Optional: Anthropic API key — enables fast Claude classification (~5s vs ~90s subprocess)
ANTHROPIC_API_KEY=

# Optional: OpenAI API key — enables OpenAI models for classification and outreach
OPENAI_API_KEY=

# Server port (default 3001)
PORT=3002
